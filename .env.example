# Copy to .env for local development: cp .env.example .env
# On Railway, set these as service variables instead (see docs/deploy.md).

# Required. Railway: reference the Postgres service, ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://paperperps:paperperps@localhost:5433/paperperps?sslmode=disable
# Only used by `make test` for integration tests.
TEST_DATABASE_URL=postgres://paperperps:paperperps@localhost:5433/paperperps_test?sslmode=disable

# HTTP port. Railway sets this itself.
PORT=8080
# Built frontend to serve. Leave empty locally and use the Vite dev server instead.
WEB_DIR=

# Market data source: testnet (default) or mainnet. Both are public and read-only.
HL_NETWORK=testnet
# Comma-separated perps. Default: top 20 by mainnet volume that also exist on testnet.
# MARKETS=BTC,ETH,HYPE,NEAR,SOL,PUMP,VVV,WLD,LIT,SUI,ZRO,DOGE,MET,PONS,ONDO,ADA,TAO,FARTCOIN,XPL,XMR

STARTING_BALANCE=1000
# HL base-tier perp fees.
TAKER_FEE_RATE=0.00045
MAKER_FEE_RATE=0.00015
# forfeit: lose remaining margin on liquidation (HL backstop). market: keep it.
LIQUIDATION_MODE=forfeit
RESET_COOLDOWN=24h

LEADERBOARD_MIN_TRADES=5
LEADERBOARD_MIN_AGE=24h
